+package expo.modules.notifications.notifications.presentation.builders
+
+import android.content.Context
+import android.os.SystemClock
+import android.widget.RemoteViews
+import androidx.core.app.NotificationCompat
+import expo.modules.notifications.R
+
+/** System UI runs this clock independently of the app's JavaScript/process. */
+internal object GymTimerNotification {
+  fun apply(
+    context: Context,
+    builder: NotificationCompat.Builder,
+    title: CharSequence?,
+    label: CharSequence?,
+    startedAt: Long
+  ) {
+    // Database timestamps use Unix milliseconds; Chronometer requires time since boot.
+    // Preserve elapsed time when the notification is replaced or the app resumes.
+    val elapsed = (System.currentTimeMillis() - startedAt).coerceAtLeast(0L)
+    val base = SystemClock.elapsedRealtime() - elapsed
+    val views = RemoteViews(context.packageName, R.layout.gym_timer_notification).apply {
+      setTextViewText(R.id.gym_timer_title, title)
+      setTextViewText(R.id.gym_timer_label, label)
+      setChronometer(R.id.gym_timer_clock, base, null, true)
+      setChronometerCountDown(R.id.gym_timer_clock, false)
+    }
+
+    builder.setWhen(startedAt)
+    builder.setShowWhen(true)
+    builder.setUsesChronometer(true)
+    builder.setChronometerCountDown(false)
+    builder.setOnlyAlertOnce(true)
+    builder.setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
+    builder.setCategory(NotificationCompat.CATEGORY_STOPWATCH)
+    builder.setStyle(NotificationCompat.DecoratedCustomViewStyle())
+    builder.setCustomContentView(views)
+    builder.setCustomBigContentView(views)
+    builder.setCustomHeadsUpContentView(views)
+  }
+}
